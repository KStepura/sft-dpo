{
  "name": "smoke_quick_base",
  "track": "",
  "description": "Fast GPU sanity check for base + Alpaca (pairs, SFT, DPO x1, compare).",
  "base_model_id": "Qwen/Qwen2.5-3B",
  "dataset_id": "tatsu-lab/alpaca",
  "prompt_style": "alpaca",
  "seed": 42,
  "paths": {
    "data_raw": "data/dpo_pairs.smoke_quick_base.raw.jsonl",
    "data_clean": "data/dpo_pairs.smoke_quick_base.clean.jsonl",
    "outputs_root": "outputs/experiments"
  },
  "data": {
    "num_examples": 64,
    "max_new_tokens": 96,
    "temperature": 0.7,
    "top_p": 0.9,
    "min_chars": 20,
    "drop_if_truncated": true,
    "drop_if_equal": true,
    "make_strict_prompt": true
  },
  "sft": {
    "max_steps": 20,
    "lr": 0.0002,
    "batch_size": 1,
    "grad_accum": 8,
    "max_seq_len": 768
  },
  "dpo": {
    "betas": [0.1],
    "max_steps": 20,
    "lr": 1e-05,
    "batch_size": 1,
    "grad_accum": 8,
    "max_length": 768,
    "max_prompt_length": 384
  },
  "eval": {
    "prompts": [
      "Explain RLHF in simple terms.",
      "Give 3 bullet points on why unit tests matter.",
      "Translate to English: 'Мне нужно подготовить отчет по экспериментам.'",
      "What is overfitting and how can we reduce it?",
      "Write a short Python function to compute factorial."
    ],
    "max_new_tokens": 120,
    "temperature": 0.0,
    "top_p": 1.0,
    "do_sample": false
  }
}
