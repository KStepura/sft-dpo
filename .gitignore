# Heavy / regenerable artifacts
#   outputs/ — LoRA adapters and DPO checkpoints (~27 GB)
#   logs/    — raw stdout/stderr of training and overnight chains
# ───────────────────────────────────────────────────────────
/outputs/
/logs/

# ───────────────────────────────────────────────────────────
# DPO preference pairs are regenerable from raw datasets;
# eval refs (data/refs.*.jsonl) ARE committed.
# ───────────────────────────────────────────────────────────
data/dpo_pairs*.jsonl
data/*.stats.json
data/compare_prompts.smoke.txt

# ───────────────────────────────────────────────────────────
# Legacy planning notes (keep locally; superseded by docs/*.md)
# ───────────────────────────────────────────────────────────
legacy/docs/*.md

