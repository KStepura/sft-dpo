{
  "name": "v2_smoke_quick",
  "track": "summarization",
  "description": "Smoke v2: 1 seed, IPO, on-policy DPO, малый объём. Проверка end-to-end за ~30-60 минут.",
  "base_model_id": "Qwen/Qwen2.5-3B",
  "dataset_id": "tatsu-lab/alpaca",
  "prompt_style": "alpaca",
  "seed": 42,
  "paths": {
    "data_raw": "data/dpo_pairs.v2_smoke.raw.jsonl",
    "data_clean": "data/dpo_pairs.v2_smoke.clean.jsonl",
    "outputs_root": "outputs"
  },
  "data": {
    "num_examples": 60,
    "max_new_tokens": 96,
    "temperature": 0.7,
    "top_p": 0.9,
    "min_chars": 20,
    "drop_if_truncated": true,
    "drop_if_equal": true,
    "make_strict_prompt": true,
    "policy_source": "onpolicy",
    "chosen_temperature": 0.0,
    "rejected_temperature": 1.2,
    "rejected_top_p": 0.95
  },
  "sft": {
    "max_steps": 50,
    "lr": 0.0002,
    "batch_size": 1,
    "grad_accum": 16,
    "max_seq_len": 1024,
    "no_packing": true
  },
  "dpo": {
    "betas": [
      0.3
    ],
    "max_steps": 20,
    "lr": 2e-06,
    "batch_size": 1,
    "grad_accum": 16,
    "max_length": 1024,
    "max_prompt_length": 512,
    "loss_type": "ipo",
    "save_steps": 5,
    "save_total_limit": 6,
    "select_checkpoint": true
  },
  "eval": {
    "refs_path": "data/refs.benchmark_summarization_base.jsonl",
    "max_new_tokens": 200,
    "temperature": 0.0,
    "top_p": 1.0,
    "do_sample": false,
    "postprocess_outputs": true
  },
  "judge": {
    "model": "",
    "base_url": "http://127.0.0.1:11434/v1",
    "api_key": "",
    "json_mode": false,
    "sleep_sec": 0.15,
    "timeout_sec": 120
  }
}